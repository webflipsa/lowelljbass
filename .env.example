# Copy to .env.local for local dev. In production set these in Vercel -> Project -> Settings -> Environment Variables.
# NEXT_PUBLIC_* values are baked in at build time — after changing one in Vercel, redeploy.

# Canonical site URL (used for metadata, sitemap, Open Graph, structured data)
NEXT_PUBLIC_SITE_URL=https://lowelljeffery.co.za

# --- Resend (contact form + "notify me" signups) ---------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=
# Where enquiries are delivered (Lowell's inbox)
CONTACT_TO_EMAIL=
# Must be an address on a domain verified in Resend, e.g. "Lowell Jeffery <website@lowelljeffery.co.za>"
CONTACT_FROM_EMAIL=

# --- Cal.com booking ---------------------------------------------------------------
# Your Cal.com path — what comes after "cal.com/". See docs/booking-cal-com.md.
#   lowelljeffery                     -> shows all your event types (visitors choose online / in person)
#   lowelljeffery/bass-lesson-online  -> embeds one specific event type
# Leave empty until the Cal.com page is live: the booking button then points at the contact form.
NEXT_PUBLIC_CAL_LINK=

# --- Search-engine ownership (optional, see docs/seo-checklist.md) ----------------
# Google Search Console -> "HTML tag" method: paste ONLY the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools (msvalidate.01 value)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Supabase (optional, not used yet) -------------------------------------------
# Reserved for storing course sign-ups / gallery photos later.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
