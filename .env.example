# Copy to .env.local for local dev. In production set these in Vercel -> Project -> Settings -> Environment Variables.

# Canonical site URL (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://lowelljeffery.co.za

# --- Resend (contact form + "notify me" signups) ---------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=
# Where enquiries are delivered (Lowell's inbox)
CONTACT_TO_EMAIL=
# Must be an address on a domain verified in Resend, e.g. "Lowell Jeffery <website@lowelljeffery.co.za>"
CONTACT_FROM_EMAIL=

# --- Booking (optional) ---------------------------------------------------------
# Cal.com / Calendly URL. When set, "Open booking calendar" links here and the scheduler embed fills the panel.
NEXT_PUBLIC_BOOKING_URL=

# --- Supabase (optional, not used yet) -------------------------------------------
# Reserved for storing course sign-ups / gallery photos later.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
